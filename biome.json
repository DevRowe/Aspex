{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "organizeImports": {
    "enabled": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "files": {
    "ignore": [
      ".claude/settings.local.json",
      "apps/web/dist/**",
      "apps/xr-lab/dist/**",
      "apps/glimmer-lab/**/build/**",
      "apps/glimmer-lab/.gradle/**",
      "apps/glimmer-lab/app/src/test/resources/**",
      "**/target/**",
      "apps/desktop/src-tauri/gen/schemas/**"
    ]
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  }
}
